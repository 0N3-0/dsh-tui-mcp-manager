{
  "name": "dsh-tui-mcp-manager",
  "version": "0.1.0",
  "description": "Native full-screen MCP manager for dsh-TUI",
  "type": "module",
  "main": "./lib/types/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./server": {
      "types": "./lib/types/server/index.d.ts",
      "import": "./lib/types/server/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "docs/images",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify.mjs",
    "check": "npm run typecheck && npm run build && npm run verify",
    "prepack": "npm run check",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-tui",
    "mcp",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0N3-0/dsh-tui-mcp-manager.git"
  },
  "homepage": "https://github.com/0N3-0/dsh-tui-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/0N3-0/dsh-tui-mcp-manager/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.23.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-harness-tui/dsh-tui": "^0.9.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-harness-tui/dsh-tui": "^0.9.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "js-yaml": "4.3.1"
  }
}
